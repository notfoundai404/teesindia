# Environment Variables
DATABASE_URL="mysql://root:password@localhost:3306/teesindia"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=5000
CLIENT_URL="http://localhost:3000"
NODE_ENV="development"

# Razorpay (get from razorpay.com dashboard)
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# File uploads
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=5242880

# Remote kill-switch (plain-text URL — return "KILL" to suspend all API routes with 503)
# Leave blank or unset to disable. App always fails-open if this URL is unreachable.
KILL_SWITCH_URL=""
